# ============================================================
# Binance SRL Sinyal Botu — Kimlik Bilgileri Şablonu
# ============================================================
# Bu dosyayı kopyalayıp ".env" olarak kaydedin:
#   cp .env.example .env
#
# Ardından gerçek değerlerinizi yazın.
# .env dosyası GitHub'a gönderilmez — sadece bilgisayarınızda kalır.
# ============================================================

# ─── Telegram ───────────────────────────────────────────────
# BotFather'dan aldığınız bot token
TELEGRAM_TOKEN=BURAYA_BOT_TOKENINIZI_YAZIN

# Telegram grubunuzun ID'si (başında eksi işareti olmalı: -100XXXXXXXXXX)
TELEGRAM_CHAT_ID=BURAYA_GRUP_ID_YAZIN

# ─── Binance API ─────────────────────────────────────────────
# Binance API anahtarınız (sadece Okuma iznine sahip olmalı)
BINANCE_API_KEY=BURAYA_API_ANAHTARINIZI_YAZIN

# Binance gizli anahtarınız
BINANCE_API_SECRET=BURAYA_GIZLI_ANAHTARINIZI_YAZIN
